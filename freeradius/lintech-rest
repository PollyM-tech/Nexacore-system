rest lintech_client {
    authorize {
        uri = "http://backend:8000/api/internal/radius/client/%{Packet-Src-IP-Address}/"
        method = 'get'
        force_to = 'json'
        do_xlat = no
        timeout = 3
    }
    pool {
        start = 0
        min = 0
        max = 16
        spare = 2
    }
}
