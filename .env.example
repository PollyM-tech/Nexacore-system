
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080

# JWT lifetimes
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

POSTGRES_DB=isp
POSTGRES_USER=isp
POSTGRES_PASSWORD=isp_password

# Runtime
GUNICORN_WORKERS=3

# Generate unique values; never use these example placeholders in a deployment.
LINTECH_ENV=development
LINTECH_RELEASE=dev
LINTECH_FIELD_ENCRYPTION_KEY=generate-a-fernet-key
RADIUS_SHARED_SECRET=generate-a-strong-radius-secret
# Production only, after buying a domain and pointing DNS at the server:
# PUBLIC_DOMAIN=billing.your-owned-domain.net

DJANGO_TIME_ZONE=Africa/Nairobi
RADIUS_CLIENT_NETWORK=192.168.88.0/24
# Separate backup key file must be kept securely off this server too.

# Registered-NAS mode requires migration/enrollment and a unique VPN address per NAS.
LINTECH_RADIUS_ISOLATED=0
LINTECH_RADIUS_INTERNAL_TOKEN=
PUBLIC_BASE_URL=
